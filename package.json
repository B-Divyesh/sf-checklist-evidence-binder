{
  "name": "proofbook",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/finalize-build.mjs",
    "preview": "node tests/server.mjs",
    "test": "vitest run src",
    "test:e2e": "npm run build && playwright test",
    "test:claims": "playwright test --project=chromium",
    "check": "npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "^26.4.0",
    "sharp": "^0.35.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
